# Copiá este archivo a .env y completá GEMINI_API_KEY.
#   cp .env.example .env

# --- Base de datos ---
# Con `docker compose up` la app usa la base del servicio `db` automáticamente.
# Este valor se usa al correr la app fuera de Docker (npm run dev).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mercanova

# Base efímera para tests (docker compose --profile test up -d db-test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/mercanova_test

# --- Inteligencia artificial (Google Gemini, free tier: no tiene costo) ---
# Cómo obtener una key gratis:
#   1. Entrá a https://aistudio.google.com/apikey con una cuenta de Google.
#   2. "Create API key" y copiala acá.
# Sin key la tienda funciona igual (catálogo, carrito, compra), pero el
# asistente y la voz quedan deshabilitados y la búsqueda usa palabras clave.
GEMINI_API_KEY=

# Modelos (opcional: estos son los valores por defecto, todos gratuitos).
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
